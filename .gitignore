# Rust
/target
# Cargo.lock se versiona a propósito (binario, no librería) para builds reproducibles.

# Frontend de la página de configuración local (web/config-ui/): node_modules
# y dist ya los ignora su propio .gitignore.

# Backup automático de Config::save (src/config.rs) antes de la primera
# reescritura de config.yaml en cada proceso.
config.yaml.bak

# Python (workers)
workers/.venv/
workers/__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/

# Caché de calibración de hardware/voz del STT (específico de cada máquina).
# Bajo Jarvis normal esto ya cae en `data/cache/` (cubierto por `/data/`);
# esta línea solo cubre el fallback cuando un worker se corre suelto sin
# pasar por Jarvis (sin `JARVIS_RUNTIME_DIR` en el entorno).
workers/.cache/

# Voces de Piper descargadas (pesan varias decenas de MB, se descargan aparte)
/voices/*
!/voices/.gitkeep

# Música del modo bienvenida (mp3 del usuario, con copyright, no se versiona)
/assets/music/*
!/assets/music/.gitkeep

# Secretos
.env

# Log que RealtimeSTT escribe en su cwd al correr el worker de STT (motor
# `realtimestt`). Bajo Jarvis normal esto ya cae en `data/` (cubierto por
# `/data/`, ver workers/stt_worker.py:_run_realtimestt); esta línea solo
# cubre el caso sin `JARVIS_RUNTIME_DIR` en el entorno.
realtimesst.log

# Memoria persistente del agente (base SQLite local, específica de cada
# usuario): DBs, audit.log, cache de hardware/voz y logs de tracing de la
# TUI ya caen todos bajo `/data/`.
/data/

# jarvis.log vivía acá antes de moverse a `data/logs/` (ver
# PLAN_RUNTIME_DIR.md fase 2). Defensa por si queda un archivo viejo en
# disco de antes de la migración; retirar en un par de commits.
logs/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# IA
.claude
.impeccable/
